# ─── NagarSetu Frontend — Environment Variable Template ────────
# Copy this file to .env and fill in your values.
# This file IS safe to commit — it contains no real secrets.
# ────────────────────────────────────────────────────────────────

# Backend API base URL (must include /api)
#
# Local development:
#   VITE_API_URL=http://localhost:5000/api
#
# Production (Render backend):
#   VITE_API_URL=https://nagarsetu-lwpw.onrender.com/api
#
# On Vercel: set this in Dashboard → Project → Settings → Environment Variables

VITE_API_URL=http://localhost:5000/api
