# ─── NagarSetu Server — Environment Variable Template ──────────
# Copy this file to .env and fill in your values.
# ────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nagarsetu?retryWrites=true&w=majority&appName=Nagarsetu

# JWT Secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_64_char_secret

# Server port (Render sets this automatically)
PORT=5000

# Set to 'production' on Render, 'development' locally
NODE_ENV=development

# Allowed frontend origin for CORS
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173
