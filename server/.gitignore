# =============================================================
# NagarSetu Server — .gitignore
# =============================================================

# ── Environment secrets (NEVER commit) ──────────────────────
.env
.env.local
.env.production
.env.staging
.env.test
*.env

# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*

# ── Runtime ──────────────────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── What IS safe to commit ───────────────────────────────────
# .env.example   → safe, documents required variables
